[ext_resource type="Texture2D" uid="uid://catmvd5folug5" path="res://assets/fourSeasonsPlatformer_ [tileset, version 2.0]/fourSeasonsPlatformer_ [tileset, version 2.0]/objects_/beeenemy.png" id="1_sauk5"]

[sub_resource type="GDScript" id="GDScript_d6ehs"]
script/source = "extends CharacterBody2D


const Waspfly = 70
const gravity = 98
@onready var ray1 = $ray/Ray1
@onready var ray2 = $ray/Ray2

var direction = 1
func _ready(): 
	velocity.x = Waspfly
	$AnimatedSprite2D.play(\"idle\")

func _physics_process(delta):
	velocity.y += gravity

	if is_on_wall():
		direction = -1
	if direction == 1 and not ray1.is_colliding():
		direction = -1 
	elif direction == -1 and not ray2.is_colliding():
			direction = 1

	velocity.x = Waspfly * direction
	if direction == 1: 
		$AnimatedSprite2D.flip_h = true
	else:
		$AnimatedSprite2D.flip_h = false


	move_and_slide()
"

